  (uri "a://[2001:db8::1]"            accept "IPv6, compressed")
  (uri "a://[1:2:3:4:5:6:7:8]"        accept "IPv6, eight groups")
  (uri "a://[::]"                     accept "IPv6, all-zero")
  (uri "a://[::ffff:192.168.0.1]"     accept "IPv4-mapped IPv6")
  (uri "a://[1:2:3:4:5:6:7:8:9]"      reject "IPv6, nine groups")
  (uri "a://[12345::1]"               reject "h16 has five hexdig")
  (uri "a://[1::2::3]"                reject "two \"::\" in IPv6")
  (uri "a://[::1.2.3.256]"            reject "dec-octet 256 in the v4 tail")
  (uri "a://[]"                       reject "empty IP-literal")
  (uri "a://[v1.aBc]"                 accept "IPvFuture")
  (uri "a://[v.abc]"                  reject "IPvFuture, no HEXDIG before \".\"")
  (uri "a://[2001:db8::1]:443"        accept "IP-literal then port")

  ;; --- IPv4 / reg-name first-match-wins (§3.2.2) ---------------------------
  (uri "a://1.2.3.4"                  accept "dotted quad is a valid host")
  (uri "a://999.1.1.1"               accept "bad quad falls through to reg-name")
  (uri "a://256.256.256.256"          accept "all-oversize quad is reg-name digits")
  (uri "a://h:99999"                  accept "port is *DIGIT, no range bound")
  (uri "a://h:"                       accept "empty port")
  (uri "a://:80"                      accept "empty host, explicit port")
  (uri "a://"                         accept "empty authority and empty path")

  ;; --- userinfo -----------------------------------------------------------
  (uri "a://user:pass@host"           accept "userinfo may contain \":\"")
  (uri "a://@h"                       accept "empty userinfo")
  (uri "a://u@"                       accept "empty host after userinfo")
  (uri "a://u@h@x"                    reject "a second \"@\" is not a reg-name byte")

  ;; --- pct-encoding at its boundary ---------------------------------------
  (uri "a:%41"                        accept "valid pct-encoded in path-rootless")
  (uri "a:%2f"                        accept "pct-encoded \"/\" is still pct-encoded")
  (uri "a:%4"                         reject "pct-encoded truncated to one HEXDIG")
  (uri "a:%"                          reject "bare \"%\"")
  (uri "a:%zz"                        reject "pct-encoded with non-HEXDIG")
  (uri "a://%41host"                  accept "pct-encoded in reg-name")
  (relative-ref "%3a/b"               accept "pct \"%3a\" is not a literal colon in noscheme")

  ;; --- path-types and the URI / relative-ref fork (deep) ------------------
  (uri "a:b/c:d/e"                    accept "path-rootless, colons in later segments")
  (relative-ref "b/c:d"               accept "path-noscheme, colon in a later segment")
  (relative-ref "b:c/d"               reject "path-noscheme, colon in the first segment")
  (uri-reference "b:c/d"              accept "…but it is a URI (scheme \"b\")")
  (uri "/a/b"                         reject "no scheme, so not a URI")
  (relative-ref "/a/b"                accept "path-absolute relative reference")
  (relative-ref "//g"                 accept "network-path relative reference")
  (uri "//g"                          reject "network-path is not a URI")
  (uri-reference "//g"                accept "…but it is a URI-reference")
  (uri "a:/./x"                       accept "dot segment in a path-absolute")
  (relative-ref "../../g"             accept "dot segments in path-noscheme")
  (uri "a:../x"                       accept "path-rootless beginning with \"..\"")

  ;; --- empty components and the mode fork over emptiness ------------------
  (uri "a:"                           accept "empty hier-part is path-empty")
  (relative-ref ""                    accept "empty is path-empty relative-ref")
  (uri-reference ""                   accept "empty is a URI-reference")
  (uri ""                             reject "empty is not a URI")
  (relative-ref "//"                  accept "empty authority, empty path")
  (uri "a:?q"                         accept "empty path with a query")
  (uri-reference "?#"                 accept "empty query and empty fragment")

  ;; --- query / fragment delimiter rules -----------------------------------
  (uri "a:b?x=1&y=2#z"                accept "query then fragment")
  (uri "a:b?a?b"                      accept "a second \"?\" is inside the query")
  (uri "a:b#a#b"                      reject "a second \"#\" is not a fragment byte")

  ;; --- scheme boundaries (deep) -------------------------------------------
  (uri "a+b-c.d:x"                    accept "scheme with \"+\" \"-\" \".\"")
  (uri "a1b2:x"                       accept "scheme with digits after the ALPHA")
  (uri "1abc:x"                       reject "scheme must begin with ALPHA")
  (uri-reference "1abc:x"             reject "neither a URI nor a relative-ref")
  (uri "+abc:x"                       reject "scheme must begin with ALPHA, not \"+\"")

  ;; --- non-ASCII / control bytes a string literal cannot carry ------------
  (relative-ref #vu8(97 128 98)       reject "0x80 in a path")
  (uri #vu8(97 58 9 98)               reject "TAB (0x09) in a path")
  (uri #vu8(104 116 116 112 58 47 47 97 0 98) reject "NUL in a path")

